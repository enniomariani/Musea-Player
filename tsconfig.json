{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": false,
    "declaration": false,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "sourceMap": true,

    "rootDir": "src",
    "outDir": "build",

    "baseUrl": ".",
    "paths": {
      "main/*": ["src/main/*"],
      "renderer/*": ["src/renderer/*"]
    }
  },
  "include": ["src/renderer/global.d.ts", "tests/**/*.ts"],
  "references": [{ "path": "src/shared" }]
}